# Copy this file to tools/.env and fill in the values. NEVER commit tools/.env.
#
# Which pair you enter selects the environment:
#   * Demo / testing  -> the SANDBOX app's credentials
#                        (portal -> Manage apps -> app -> switch to Sandbox
#                         -> the sandbox's Credentials section)
#   * Real use        -> the PRODUCTION app's credentials (after app review)
# Sandbox and Production have separate client key/secret pairs.

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match a redirect URI registered in the app's Login Kit
# (Desktop) settings: loopback host, explicit port, no query/fragment.
TIKTOK_REDIRECT_URI=http://127.0.0.1:8080/callback/

# Scopes enabled on the app and requested during authorization.
TIKTOK_SCOPES=user.info.basic,video.upload

# Optional: where OAuth tokens are stored (default: tools/.tiktok_token.json).
# TIKTOK_TOKEN_FILE=
